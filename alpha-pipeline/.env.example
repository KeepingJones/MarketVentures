# Alpaca paper trading (paper-api.alpaca.markets — NOT live trading)
# Get free keys at: https://alpaca.markets/
ALPACA_API_KEY=your_alpaca_paper_key
ALPACA_SECRET_KEY=your_alpaca_paper_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# FRED macro data (free, no rate limits for daily use)
# Get key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_key

# Shared database path (default works if run from repo root)
SHARED_DB_PATH=C:\Users\your_username\MarketVentures\fund.db

# Ollama local LLM (optional — only needed for natural language signal summaries)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3.5

# API server port
API_PORT=8002
