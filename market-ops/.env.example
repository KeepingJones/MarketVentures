# Shared database (all 5 projects share fund.db at repo root)
SHARED_DB_PATH=C:\Users\your_username\MarketVentures\fund.db

# Upstream project API endpoints (market-ops polls these for live data)
PRICE_RECON_API=http://localhost:8000
MARKET_DATA_HUB_API=http://localhost:8001
ALPHA_PIPELINE_API=http://localhost:8002
DATA_ONBOARD_API=http://localhost:8003

# API server port
API_PORT=8004

# Report output directory
REPORT_OUTPUT_DIR=./reports/output

# Ollama LLM (optional — ollama.com)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3.5

# FRED macro data (optional)
FRED_API_KEY=your_fred_key
