# FRED macro data (free at fred.stlouisfed.org)
FRED_API_KEY=your_fred_key

# Shared database (all 5 projects share fund.db at repo root)
DB_PATH=C:\Users\your_username\MarketVentures\fund.db

# Fund base currency
FUND_BASE_CURRENCY=GBP

# Report output directory
REPORT_OUTPUT_DIR=./reports/output

# API server port
API_PORT=8000
