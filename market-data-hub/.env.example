# FRED macro data (free at fred.stlouisfed.org)
FRED_API_KEY=your_fred_key

# Alpha Vantage (free tier: 25 requests/day — alphavantage.co)
ALPHA_VANTAGE_KEY=your_alpha_vantage_key

# Shared database (all 5 projects share fund.db at repo root)
SHARED_DB_PATH=C:\Users\your_username\MarketVentures\fund.db

# API server port
API_PORT=8001

# Ollama LLM for catalogue queries (optional — ollama.com)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3.5
