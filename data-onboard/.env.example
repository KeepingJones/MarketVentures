# Shared database (all 5 projects share fund.db at repo root)
SHARED_DB_PATH=C:\Users\your_username\MarketVentures\fund.db

# OpenFIGI (free, optional — higher rate limits with key at openfigi.com)
OPENFIGI_API_KEY=your_openfigi_key

# FRED macro data (free at fred.stlouisfed.org)
FRED_API_KEY=your_fred_key

# API server port
API_PORT=8003

# Ollama LLM for integration spec generation (optional — ollama.com)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3.5
